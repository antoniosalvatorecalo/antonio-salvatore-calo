  "author": "Antonio Salvatore Calò <antonio.salvatore.calo@gmail.com>",
  "homepage": "https://github.com/antoniosalvatorecalo/antonio-salvatore-calo",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run budget:check",
    "budget:check": "node scripts/verify/performance-budget.mjs",
    "verify:prerender": "node scripts/verify/prerender.mjs",
    "verify:agentic": "node scripts/verify/agentic.mjs",
    "verify:preloader": "node scripts/verify/preloader.mjs",
    "verify:project-transition": "node scripts/verify/project-transition.mjs",
    "verify:project-media": "node scripts/verify/project-media.mjs",
    "verify:cms": "node scripts/verify/cms-catalog.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "hooks:check": "node scripts/git-hooks/pre-commit-check.mjs --check",
    "annulla": "node scripts/git/annulla.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "groq": "^6.20.0",
    "motion": "^12.43.0",
    "nodemailer": "^8.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "gsap": "^3.15.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5"
  }
}
