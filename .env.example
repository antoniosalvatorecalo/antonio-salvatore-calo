# =============================================================================
# Antonio Salvatore Calò — Portfolio — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or .env.* files (they are gitignored).
#
# Vite convention:
#   .env                — loaded in all cases (keep public vars here)
#   .env.local          — local overrides, loaded in all cases (gitignored)
#   .env.development    — loaded in dev mode (gitignored)
#   .env.production     — loaded in production build (gitignored)
#
# All variables exposed to client must be prefixed with VITE_.
# See: https://vite.dev/guide/env-and-mode
# =============================================================================

# --- Site Configuration ---
# VITE_SITE_URL=  # TODO(deployment): set to final Vercel domain once known

# --- Contact ---
# VITE_CONTACT_EMAIL=antonio.salvatore.calo@gmail.com

# --- Contact API (Vercel serverless) ---
# The email address where contact form submissions are sent.
# CONTACT_EMAIL=antonio.salvatore.calo@gmail.com
#
# SMTP credentials for sending contact form emails.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=antonio.salvatore.calo@gmail.com
# SMTP_PASS=your-app-password-here
#
# If SMTP is not configured, the API returns a mailto fallback link
# and the client opens the user's email client instead.

# --- Vercel (for deployment, set via Vercel Dashboard, not .env) ---
# VERCEL=1
# VERCEL_ENV=production

# --- Analytics (optional) ---
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Sentry Error Tracking (optional) ---
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Contentful CMS (optional) ---
# VITE_CONTENTFUL_SPACE_ID=xxxxxxxxxxxx
# VITE_CONTENTFUL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
